{
    "name": "mcrud/schema-studio",
    "description": "A browser-based Laravel schema, CRUD and dashboard generator.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "mhmd elbadry",
            "email": "m7mdelbadry72@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/view": "^10.0|^11.0|^12.0",
        "spatie/laravel-permission": "^6.0"
    },
    "autoload": {"psr-4": {"Mcrud\\Crud\\": "src/"}},
    "autoload-dev": {"psr-4": {"Mcrud\\Crud\\Tests\\": "tests/"}},
    "require-dev": {"phpunit/phpunit": "^10.5|^11.0"},
    "scripts": {"test": "phpunit"},
    "extra": {"laravel": {"providers": ["Mcrud\\Crud\\CrudServiceProvider"]}},
    "minimum-stability": "stable",
    "prefer-stable": true
}
