@if ($datasets)
@push('scripts')
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    (function () {
        var palette = ['#6366f1', '#10b981', '#f59e0b', '#ef4444', '#0ea5e9', '#a855f7', '#14b8a6', '#f97316'];
        var datasets = @json($datasets).map(function (set, i) {
            return Object.assign(set, { borderColor: palette[i % palette.length], backgroundColor: palette[i % palette.length], tension: 0.3, pointRadius: 0, borderWidth: 2 });
        });
        var chart = new Chart(document.getElementById('growth'), {
            type: 'line',
            data: { labels: @json($labels), datasets: datasets },
            options: { responsive: true, maintainAspectRatio: false, interaction: { mode: 'index', intersect: false }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
        });
        function theme() {
            var dark = document.documentElement.classList.contains('dark');
            var text = dark ? '#94a3b8' : '#64748b', grid = dark ? '#1e293b' : '#e2e8f0';
            chart.options.scales.x.ticks.color = text; chart.options.scales.y.ticks.color = text;
            chart.options.scales.x.grid.color = grid; chart.options.scales.y.grid.color = grid;
            chart.options.plugins.legend.labels.color = text;
            chart.update();
        }
        document.addEventListener('themechange', theme);
        theme();
    })();
</script>
@endpush
@endif
