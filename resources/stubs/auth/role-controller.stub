<?php

namespace App\Http\Controllers\Admin;

use App\Http\Controllers\Controller;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Str;
use Illuminate\Validation\Rule;
use Spatie\Permission\Models\Permission;
use Spatie\Permission\Models\Role;

/** Roles and the permission matrix. Routes are guarded by the roles.manage permission. */
class RoleManagementController extends Controller
{
    private const PROTECTED = 'super-admin';

    public function index()
    {
        return view('admin.roles.index', ['roles' => Role::withCount('permissions')->orderBy('name')->get()]);
    }

    public function create()
    {
        return view('admin.roles.form', ['role' => null, 'groups' => $this->groups(), 'granted' => []]);
    }

    public function store(Request $request): RedirectResponse
    {
        $data = $this->validated($request);
        $role = Role::create(['name' => $data['name']]);
        $role->syncPermissions($data['permissions'] ?? []);

        return redirect()->route('roles.index')->with('status', 'Role created.');
    }

    public function edit(Role $role)
    {
        return view('admin.roles.form', ['role' => $role, 'groups' => $this->groups(), 'granted' => $role->permissions->pluck('name')->all()]);
    }

    public function update(Request $request, Role $role): RedirectResponse
    {
        $data = $this->validated($request, $role);
        // The protected role keeps its name so seeders and checks that rely on it keep working.
        if ($role->name !== self::PROTECTED) $role->update(['name' => $data['name']]);
        $role->syncPermissions($data['permissions'] ?? []);

        return redirect()->route('roles.index')->with('status', 'Role updated.');
    }

    public function destroy(Role $role): RedirectResponse
    {
        abort_if($role->name === self::PROTECTED, 403, 'The super-admin role cannot be deleted.');
        $role->delete();

        return redirect()->route('roles.index')->with('status', 'Role deleted.');
    }

    private function validated(Request $request, ?Role $role = null): array
    {
        return $request->validate([
            'name' => ['required', 'string', 'max:80', Rule::unique('roles', 'name')->ignore($role?->getKey())],
            'permissions' => ['nullable', 'array'],
            'permissions.*' => ['exists:permissions,name'],
        ]);
    }

    /** Permissions are named "<table>.<action>", so they are grouped by the table. */
    private function groups()
    {
        return Permission::orderBy('name')->get()->groupBy(fn ($permission) => Str::before($permission->name, '.'));
    }
}
