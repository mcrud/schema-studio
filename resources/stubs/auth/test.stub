<?php

namespace Tests\Feature;

use App\Models\User;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Illuminate\Support\Facades\Hash;
use Tests\TestCase;

class AuthTest extends TestCase
{
    use RefreshDatabase;

    private function user(): User
    {
        return User::factory()->create(['email' => 'person@example.com', 'password' => Hash::make('secret-pass-123')]);
    }

    public function test_login_page_is_available_to_guests(): void
    {
        $this->get(route('login'))->assertOk();
    }

    public function test_user_can_log_in_and_out(): void
    {
        $this->user();

        $this->post(route('login'), ['email' => 'person@example.com', 'password' => 'secret-pass-123'])->assertRedirect();
        $this->assertAuthenticated();

        $this->post(route('logout'))->assertRedirect(route('login'));
        $this->assertGuest();
    }

    public function test_wrong_credentials_are_rejected(): void
    {
        $this->user();

        $this->from(route('login'))->post(route('login'), ['email' => 'person@example.com', 'password' => 'wrong'])->assertSessionHasErrors('email');
        $this->assertGuest();
    }

    public function test_guests_are_redirected_from_protected_pages(): void
    {
        $this->get(route('profile.edit'))->assertRedirect(route('login'));
    }

    public function test_profile_can_be_updated(): void
    {
        $user = $this->user();

        $this->actingAs($user)->put(route('profile.update'), ['name' => 'Renamed', 'email' => 'person@example.com'])->assertSessionHasNoErrors();

        $this->assertSame('Renamed', $user->fresh()->name);
    }

    public function test_password_can_be_changed_with_the_current_password(): void
    {
        $user = $this->user();

        $this->actingAs($user)->put(route('profile.password'), ['current_password' => 'secret-pass-123', 'password' => 'another-pass-456', 'password_confirmation' => 'another-pass-456'])->assertSessionHasNoErrors();

        $this->assertTrue(Hash::check('another-pass-456', $user->fresh()->password));
    }
[[registration]]}
