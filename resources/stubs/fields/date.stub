            <input id="[[name]]" name="[[name]]" type="date" value="{{ old('[[name]]', isset($item) ? $item->[[name]]?->format('Y-m-d') : '') }}" class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200">
