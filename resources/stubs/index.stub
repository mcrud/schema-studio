<script>
(function () {
    var key = 'cols:[[table]]', hidden = [];
    try { hidden = JSON.parse(localStorage.getItem(key) || '[]'); } catch (e) {}
    function apply() {
        document.querySelectorAll('[data-col]').forEach(function (el) { el.style.display = hidden.indexOf(el.dataset.col) === -1 ? '' : 'none'; });
        document.querySelectorAll('[data-col-toggle]').forEach(function (box) { box.checked = hidden.indexOf(box.dataset.colToggle) === -1; });
    }
    document.querySelectorAll('[data-col-toggle]').forEach(function (box) {
        box.addEventListener('change', function () {
            hidden = hidden.filter(function (c) { return c !== box.dataset.colToggle; });
            if (!box.checked) hidden.push(box.dataset.colToggle);
            try { localStorage.setItem(key, JSON.stringify(hidden)); } catch (e) {}
            apply();
        });
    });
    apply();
})();
</script>
