    <script src="https://cdn.tailwindcss.com"></script>
    <script>tailwind.config = { darkMode: 'class' }</script>
    <style>
        /* Generated CRUD views use light utility classes; map them to a dark palette. */
        .dark body { background: #020617; color: #e2e8f0; }
        .dark .bg-white { background-color: #0f172a; }
        .dark .bg-slate-50, .dark .bg-slate-100 { background-color: #1e293b; }
        .dark .border-slate-100, .dark .border-slate-200, .dark .border-slate-300 { border-color: #334155; }
        .dark .text-slate-900, .dark .text-slate-800, .dark .text-slate-700 { color: #f1f5f9; }
        .dark .text-slate-600, .dark .text-slate-500 { color: #94a3b8; }
        .dark input, .dark select, .dark textarea { background-color: #0f172a; color: #f1f5f9; border-color: #334155; }
        .dark .hover\:bg-slate-100:hover { background-color: #1e293b; }
    </style>
</head>
